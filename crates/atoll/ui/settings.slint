import { Button, CheckBox, SpinBox, TabWidget, VerticalBox, HorizontalBox } from "std-widgets.slint";

// The settings window is the one place Atoll shows a conventional window, so it
// uses the platform style rather than the hand-drawn one everything else has:
// it is a dialog, and it should look like the operating system's dialogs.
export component SettingsWindow inherits Window {
    title: "Atoll Settings";
    preferred-width: 460px;
    preferred-height: 300px;
    min-width: 420px;
    min-height: 280px;

    in property <bool> claude-installed;
    // Human-readable state of the hook wiring, e.g. "8 of 8 hooks installed".
    in property <string> claude-status: "checking…";
    // Whether Claude Code's own directory exists on this machine at all. A
    // machine without it is a normal machine; the row says what it found.
    in property <bool> claude-present: true;

    // The outcome of the last button press, shown along the bottom.
    in property <string> message;

    callback install();
    callback uninstall();

    in property <bool> taskbar-enabled: true;
    // What the readout actually managed to do — embedded in the taskbar, or
    // floating against it because the shell would not take a child.
    in property <string> taskbar-status;
    callback set-taskbar-enabled(bool);

    // Read from the registry, which is the mechanism itself, so this can never
    // drift from what Windows will actually do.
    in property <bool> run-at-login;
    callback set-run-at-login(bool);

    in property <bool> show-claude: true;
    in property <bool> show-codex: true;
    // "claude" | "codex", and whether it gets its block in the readout.
    callback set-agent-shown(string, bool);

    // Where the percentage-left colour turns; see `usage_cache::left_tier`.
    in property <int> good-at: 50;
    in property <int> warn-at: 20;
    callback set-thresholds(int, int);

    VerticalBox {
        TabWidget {
            Tab {
                title: "Setup";
                VerticalBox {
                    alignment: start;
                    spacing: 14px;

                    HorizontalBox {
                        padding: 0px;
                        alignment: start;
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            width: 180px;
                            Text {
                                text: "Claude Code";
                                font-weight: 600;
                            }
                            Text {
                                text: root.claude-status;
                                font-size: 11px;
                                wrap: word-wrap;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Button {
                                text: root.claude-installed ? "Uninstall" : "Install";
                                primary: !root.claude-installed && root.claude-present;
                                enabled: root.claude-present;
                                clicked => {
                                    if (root.claude-installed) {
                                        root.uninstall();
                                    } else {
                                        root.install();
                                    }
                                }
                            }
                        }
                    }

                    Text {
                        text: "The hooks are how Atoll sees your sessions: what each one is doing, and when one stops to ask you something. They are added alongside anything you already have, and uninstalling removes exactly what was added.";
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                }
            }

            Tab {
                title: "General";
                VerticalBox {
                    alignment: start;
                    spacing: 12px;

                    CheckBox {
                        text: "Start Atoll at login";
                        checked: root.run-at-login;
                        toggled => {
                            root.set-run-at-login(self.checked);
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: #80808040;
                    }

                    CheckBox {
                        text: "Show usage in the taskbar";
                        checked: root.taskbar-enabled;
                        toggled => {
                            root.set-taskbar-enabled(self.checked);
                        }
                    }
                    Text {
                        text: root.taskbar-status;
                        font-size: 11px;
                        wrap: word-wrap;
                    }

                    HorizontalBox {
                        padding: 0px;
                        alignment: start;
                        spacing: 18px;
                        CheckBox {
                            text: "Claude Code";
                            checked: root.show-claude;
                            enabled: root.taskbar-enabled;
                            toggled => {
                                root.set-agent-shown("claude", self.checked);
                            }
                        }
                        CheckBox {
                            text: "Codex";
                            checked: root.show-codex;
                            enabled: root.taskbar-enabled;
                            toggled => {
                                root.set-agent-shown("codex", self.checked);
                            }
                        }
                    }

                    HorizontalBox {
                        padding: 0px;
                        alignment: start;
                        spacing: 8px;
                        VerticalLayout {
                            alignment: center;
                            Text { text: "Green at ≥"; }
                        }
                        good-spin := SpinBox {
                            minimum: 1;
                            maximum: 100;
                            value: root.good-at;
                            edited(value) => {
                                root.set-thresholds(value, warn-spin.value);
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Text { text: "%   amber at ≥"; }
                        }
                        warn-spin := SpinBox {
                            minimum: 0;
                            maximum: 99;
                            value: root.warn-at;
                            edited(value) => {
                                root.set-thresholds(good-spin.value, value);
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Text { text: "%, red below"; }
                        }
                    }
                }
            }
        }

        Text {
            text: root.message;
            font-size: 11px;
            wrap: word-wrap;
            height: 32px;
        }
    }
}
